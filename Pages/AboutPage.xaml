<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameLauncher.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GameLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="关于" />

        <StackPanel Grid.Row="1" Spacing="20" MaxWidth="600">
            <StackPanel Spacing="4">
                <TextBlock Text="GameLauncher" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="版本 1.3.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                TextWrapping="Wrap"
                LineHeight="28"
                Text="一个轻量级的游戏启动器，帮助你管理和快速启动本地游戏。支持 Steam / Epic 游戏自动导入、AI 描述简化、轮播图与截图管理等功能。" />

            <StackPanel Spacing="8">
                <TextBlock Text="功能说明" FontSize="18" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="  " /><Run Text="添加、删除和管理多个游戏" /><LineBreak />
                    <Run Text="  " /><Run Text="为每个游戏设置启动路径（.exe / .lnk）" /><LineBreak />
                    <Run Text="  " /><Run Text="Steam / Epic 游戏自动检测与导入" /><LineBreak />
                    <Run Text="  " /><Run Text="通过 Steam AppID 启动游戏，兼容 D 加密" /><LineBreak />
                    <Run Text="  " /><Run Text="自定义 Steam 库路径" /><LineBreak />
                    <Run Text="  " /><Run Text="AI 智能简化游戏描述（支持 OpenAI / Anthropic API）" /><LineBreak />
                    <Run Text="  " /><Run Text="为每个游戏添加多张轮播图，选中时自动轮播" /><LineBreak />
                    <Run Text="  " /><Run Text="游戏截图库管理" /><LineBreak />
                    <Run Text="  " /><Run Text="图片裁切（支持 16:9 / 4:3 / 1:1 / 自由比例）" /><LineBreak />
                    <Run Text="  " /><Run Text="收藏夹、搜索过滤、拖拽排序" /><LineBreak />
                    <Run Text="  " /><Run Text="游玩次数与最近启动时间记录" /><LineBreak />
                    <Run Text="  " /><Run Text="支持多种主题风格（浅色/深色/跟随系统）" /><LineBreak />
                    <Run Text="  " /><Run Text="支持 Mica 和 Acrylic 背景效果" /><LineBreak />
                    <Run Text="  " /><Run Text="数据自动保存到本地" />
                </TextBlock>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="使用方法" FontSize="18" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="1. 点击左下角齿轮按钮进入设置" /><LineBreak />
                    <Run Text="2. 点击「添加游戏」手动创建条目，或点击「导入 Steam/Epic」自动扫描" /><LineBreak />
                    <Run Text="3. 点击「浏览」选择游戏的可执行文件" /><LineBreak />
                    <Run Text="4. Steam 游戏可填写 AppID（自动导入的已自动填写）" /><LineBreak />
                    <Run Text="5. 可选：为游戏添加轮播图和截图，支持裁切" /><LineBreak />
                    <Run Text="6. 可选：配置 AI API 地址和 Key，使用 AI 简化描述" /><LineBreak />
                    <Run Text="7. 点击「保存修改」确认" /><LineBreak />
                    <Run Text="8. 返回游戏库，点击游戏即可启动" />
                </TextBlock>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="技术栈" FontSize="18" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="  " /><Run Text="WinUI 3（Windows App SDK 1.7）" /><LineBreak />
                    <Run Text="  " /><Run Text=".NET 10 / C#" /><LineBreak />
                    <Run Text="  " /><Run Text="打包模式：Unpackaged（免安装）" />
                </TextBlock>
            </StackPanel>

            <Border
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                Text="Built with WinUI 3 and .NET 10"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
