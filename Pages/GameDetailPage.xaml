<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameLauncher.Pages.GameDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GameLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:GameLauncher.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToMediaSourceConverter x:Key="MediaSourceConverter" />
        <converters:CarouselTemplateSelector x:Key="CarouselTemplateSelector">
            <converters:CarouselTemplateSelector.ImageTemplate>
                <DataTemplate x:DataType="x:String">
                    <Image Source="{x:Bind}" Stretch="Uniform" />
                </DataTemplate>
            </converters:CarouselTemplateSelector.ImageTemplate>
            <converters:CarouselTemplateSelector.VideoTemplate>
                <DataTemplate x:DataType="x:String">
                    <MediaPlayerElement
                        Source="{x:Bind Converter={StaticResource MediaSourceConverter}}"
                        AutoPlay="False"
                        AreTransportControlsEnabled="True"
                        Stretch="Uniform" />
                </DataTemplate>
            </converters:CarouselTemplateSelector.VideoTemplate>
        </converters:CarouselTemplateSelector>
    </Page.Resources>

    <Grid RowSpacing="10" Padding="16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Click="Back_Click"
                Padding="8,4"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="返回" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefault}"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <FlipView
                x:Name="CarouselFlipView"
                Visibility="Collapsed"
                ItemTemplateSelector="{StaticResource CarouselTemplateSelector}" />

            <StackPanel
                x:Name="NoCarouselPanel"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="8">
                <FontIcon
                    Glyph="&#xE7C3;"
                    FontSize="48"
                    Opacity="0.2"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="暂无轮播图"
                    FontSize="14"
                    Opacity="0.4"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="12,10"
            Background="{ThemeResource CardBackgroundFillColorDefault}"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Grid Width="32" Height="32" CornerRadius="4">
                        <FontIcon
                            x:Name="DefaultIcon"
                            Glyph="&#xE7FC;"
                            FontSize="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.35" />
                        <Image
                            x:Name="GameIcon"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock
                        x:Name="GameNameText"
                        FontSize="18"
                        FontWeight="Bold"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        x:Name="GameDescText"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        MaxLines="3"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="SimplifyBtn"
                        Content="AI 简化"
                        Click="SimplifyDesc_Click"
                        Padding="6,2"
                        FontSize="11"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon
                        Glyph="&#xE8DA;"
                        FontSize="12"
                        Opacity="0.4"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="ExePathText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        VerticalAlignment="Center" />
                    <Button
                        Click="OpenFolder_Click"
                        Padding="4,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="打开文件所在文件夹">
                        <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <Button
                x:Name="LaunchButton"
                Grid.Column="1"
                Click="Launch_Click"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Center"
                Margin="12,0,0,0"
                Padding="24,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" />
                    <TextBlock Text="启动游戏" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
